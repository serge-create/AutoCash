<Window x:Class="AutoCash.Views.Management.ProductManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCash.Views.Management"
        mc:Ignorable="d"
        Title="ProductManager" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Управление товарами" FontSize="18" FontWeight="Bold" Margin="10"/>
            <DataGrid x:Name="dgProducts" Margin="10" AutoGenerateColumns="True"/>
        </StackPanel>
    </Grid>
</Window>
