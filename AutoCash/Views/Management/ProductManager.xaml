<Window x:Class="AutoCash.Views.Management.ProductManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление товарным справочником" Height="800" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9" Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Поиск по наименованию / штрихкоду" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSearch" Height="35" Padding="5,7" FontSize="14" TextChanged="txtSearch_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Категория товара" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbGroups" Height="35" DisplayMemberPath="Name" SelectionChanged="cbGroups_SelectionChanged"/>
                    </StackPanel>

                    <Button x:Name="btnResetFilter" Grid.Column="2" Content="Сбросить" Width="90" Height="35" 
                            VerticalAlignment="Bottom" Background="#94A3B8" Foreground="White" BorderThickness="0" Click="btnResetFilter_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="10">
                <DataGrid x:Name="dgProducts" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" FontSize="14" SelectionChanged="dgProducts_SelectionChanged"
                          Background="White" RowHeight="32" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          MouseDown="dgProducts_MouseDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Штрихкод" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:F2} ₽}" Width="90"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="80"/>
                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding MeasureUnits.Name}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblCardTitle" Grid.Row="0" Text="Добавление / Редактирование" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Артикул" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtArticle" Height="35" MaxLength="50" Margin="0,0,0,12" Padding="5"/>

                        <TextBlock Text="Штрихкод (EAN-13)" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtBarcode" Height="35" MaxLength="50" Margin="0,0,0,12" Padding="5"/>

                        <TextBlock Text="Наименование товара" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtProductName" Height="35" MaxLength="200" Margin="0,0,0,12" Padding="5" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Розничная цена" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtPrice" Height="35" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Текущий остаток" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtStock" Height="35" Padding="5"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Макс. скидка (%)" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDiscount" Height="35" Padding="5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Ставка НДС" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cbVATRate" Height="35" DisplayMemberPath="Name" SelectedValuePath="TaxRateID"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Товарная группа" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cbCardGroup" Grid.Column="0" Height="35" DisplayMemberPath="Name" SelectedValuePath="GroupID"/>
                            <Button x:Name="btnAddGroup" Grid.Column="1" Content="+" Height="35" Margin="5,0,0,0" 
                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="16" Click="btnAddGroup_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock Text="Единица измерения" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cbCardUnit" Height="35" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="UnitID"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,15,0,0">
                    <Button x:Name="btnSave" Content="Сохранить товар" Height="40" Margin="0,0,0,8"
                            Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnSave_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnClear" Grid.Column="0" Content="Очистить форму" Height="35" Margin="0,0,4,0"
                                Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Click="btnClear_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnDelete" Grid.Column="1" Content="Удалить" Height="35" Margin="4,0,0,0"
                                Background="#EF4444" Foreground="White" BorderThickness="0" Click="btnDelete_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>