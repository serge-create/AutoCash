<Window x:Class="AutoCash.Views.Management.EmployeeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление персоналом (Администрирование)" Height="550" Width="850"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F1F5F9" Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="10" Margin="0,0,55,0">
            <DataGrid x:Name="dgEmployees" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" FontSize="14" SelectionChanged="dgEmployees_SelectionChanged"
                      Background="White" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО сотрудника" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding Roles.RoleName}" Width="150"/>
                    <DataGridTextColumn Header="ПИН-код" Binding="{Binding PinCode}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Background="White" CornerRadius="6" Padding="20" Grid.ColumnSpan="2" Margin="480,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblCardTitle" Grid.Row="0" Text="Новый сотрудник" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="ФИО (Полностью)" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtFullName" Height="35" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                    <TextBlock Text="Роль в системе" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbRoles" Height="35" Margin="0,0,0,15" DisplayMemberPath="RoleName" SelectedValuePath="RoleID" FontSize="14"/>

                    <TextBlock Text="Индивидуальный ПИН-код" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtPinCode" Grid.Column="0" Height="35" Padding="5" FontSize="14" FontWeight="Bold" MaxLength="6" Margin="0,0,5,0"/>

                        <Button x:Name="btnGeneratePin" Grid.Column="1" Content="Сгенерировать" Height="35"
            Background="#10B981" Foreground="White" BorderThickness="0" Click="btnGeneratePin_Click" Margin="10,0,0,0" HorizontalAlignment="Left" Width="131">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    <TextBlock Text="*Используется для входа в кассу" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Button x:Name="btnSave" Content="Сохранить" Height="40" Margin="0,0,0,8"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnSave_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnClear" Grid.Column="0" Content="Очистить" Height="35" Margin="0,0,4,0"
                                Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Click="btnClear_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnDelete" Grid.Column="1" Content="Удалить" Height="35" Margin="4,0,0,0"
                                Background="#EF4444" Foreground="White" BorderThickness="0" Click="btnDelete_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>