<Window x:Class="AutoCash.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление оплаты" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#34495E" CornerRadius="6" Padding="15,10" Margin="0,0,0,15">
            <TextBlock x:Name="lblPaymentType" Text="ОПЛАТА: НАЛИЧНЫЕ" Foreground="White" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="ИТОГО К ОПЛАТЕ" FontSize="14" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border Background="#E2E8F0" CornerRadius="6" Padding="10">
                <TextBlock x:Name="txtTotalSum" Text="0.00 ₽" FontSize="36" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Right"/>
            </Border>
        </StackPanel>

        <StackPanel x:Name="spAmountReceived" Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="ВНЕСЕНО КЛИЕНТОМ" FontSize="14" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtReceived" FontSize="32" FontWeight="Bold" Foreground="#1E293B" 
                     TextAlignment="Right" Padding="5" Height="60" 
                     TextChanged="txtReceived_TextChanged" PreviewTextInput="txtReceived_PreviewTextInput"/>
        </StackPanel>

        <StackPanel x:Name="spChange" Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="СДАЧА" FontSize="14" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Border Background="#DCFCE7" CornerRadius="6" Padding="10">
                <TextBlock x:Name="txtChange" Text="0.00 ₽" FontSize="36" FontWeight="Black" Foreground="#15803D" HorizontalAlignment="Right"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="4" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancel" Grid.Column="0" Content="ОТМЕНА (Esc)" Height="55" Margin="0,0,5,0"
                    Background="#EF4444" FontSize="16" FontWeight="Bold"
                    Click="btnCancel_Click"/>

            <Button x:Name="btnConfirm" Grid.Column="1" Content="ПРОБИТЬ ЧЕК (Enter)" Height="55" Margin="5,0,0,0"
                    Background="#10B981" FontSize="16" FontWeight="Bold"
                    Click="btnConfirm_Click"/>
        </Grid>
    </Grid>
</Window>