<Window x:Class="AutoCash.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее место кассира (РМК)" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="AutoCash РМК" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock x:Name="txtCurrentUser" Foreground="#BDC3C7" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="spAdminMenu" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnProducts" Content="Управление товарами" Width="150" Margin="5" Click="btnProducts_Click"/>
                    <Button x:Name="btnShifts" Content="Кассовые смены" Width="120" Margin="5" Click="btnShifts_Click"/>
                    <Button x:Name="btnAnalytics" Content="Аналитика смен" Width="120" Margin="5" Background="#16A34A" Foreground="White" BorderThickness="0" Click="btnAnalytics_Click"/>
                    <Button x:Name="btnEmployees" Content="Персонал" Width="100" Margin="5" Click="btnEmployees_Click"/>
                    <Button x:Name="btnLogout" Content="Сменить пользователя" Width="150" Margin="5" Background="#E74C3C" Foreground="White" BorderThickness="0" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="10" Margin="0,0,10,0">
                <DataGrid x:Name="dgReceipt" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                        <DataGridTextColumn Header="Скидка" Binding="{Binding Discount}" Width="80"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Column="1" Background="White" Margin="0" >
                <Button x:Name="btnSearchProduct" Content="Поиск товара (F3)" Height="50" Margin="10" FontSize="16" Click="btnSearchProduct_Click"/>
                <Button x:Name="btnStorno" Content="Сторно (Удалить строку)" Height="50" Margin="10" FontSize="16" Background="#F1C40F" Click="btnStorno_Click"/>
                <Button x:Name="btnClearReceipt" Content="Очистить чек" Height="50" Margin="10" FontSize="16" Background="#E67E22" Foreground="White" Click="btnClearReceipt_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="К ОПЛАТЕ: " FontSize="36" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="txtTotalAmount" Text="0.00 ₽" FontSize="42" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>

                <Button Grid.Column="1" Content="НАЛИЧНЫЕ (F9)" Width="180" Height="60" Margin="10,0" Background="#2ECC71" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0"/>
                <Button Grid.Column="2" Content="БАНК. КАРТА (F10)" Width="180" Height="60" Margin="0" Background="#3498DB" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>