<Window x:Class="AutoCash.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCash — Авторизация" Height="400" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" KeyDown="Window_KeyDown">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" Width="320" Padding="25" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.06" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="AutoCash" FontSize="28" FontWeight="Black" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Автоматизированное рабочее место" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="ЛИЧНЫЙ ПАРОЛЬ (ПИН-КОД)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="40" Padding="10,8" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10" VerticalContentAlignment="Center">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <TextBlock x:Name="lblError" Text="Неверный пароль" Foreground="#EF4444" FontSize="12" 
                           FontWeight="Medium" HorizontalAlignment="Center" Margin="0,5,0,15" Visibility="Collapsed"/>

                <Button x:Name="btnLogin" Content="Войти в систему" Height="42" Margin="0,5,0,0"
                        Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0"
                        Click="btnLogin_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>